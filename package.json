{
  "name": "synthonia-hub",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp quote assistant for Synthonia — collects event details from customers via AI chat and lets the owner approve quotes from WhatsApp",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "simulate": "tsx src/simulator/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
