# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=            # stringa segreta a tua scelta, da inserire anche nella dashboard Meta
APP_SECRET=              # App Secret dell'app Meta, usato per verificare la firma dei webhook

# Anthropic (Claude) — OPZIONALE.
# Lascia vuoto per usare il flusso guidato deterministico (gratis, nessuna API).
# Inserisci una chiave (console.anthropic.com) per attivare la conversazione AI
# in linguaggio naturale (~1-3 centesimi a preventivo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Business
OWNER_PHONE=39XXXXXXXXXX # numero del titolare in formato internazionale, senza '+'
PORT=3000
DB_PATH=./data/synthonia.db

# URL pubblico del server: entra nei link di conferma stampati sul PDF, quindi
# deve essere raggiungibile dal telefono del cliente (NON localhost in produzione).
# In locale usa l'URL del tunnel (es. Cloudflare Tunnel — vedi README).
PUBLIC_BASE_URL=http://localhost:3000
